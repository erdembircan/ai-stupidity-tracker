      printf '%s\n' "$R_DATA" | jq -r '.degradations[] | "\(.name)|\(.severity)|\(.type)|\(.message)"' | while IFS='|' read -r name severity dtype message; do
        local clean_msg
        clean_msg=$(printf '%s' "$message" | LC_ALL=C tr -cd '\11\12\40-\176' | sed 's/^ *//; s/^[A-Z_ ]*: //')
