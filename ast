#!/usr/bin/env bash
set -euo pipefail

# ── Constants ───────────────────────────────────────
readonly VERSION="1.5.0"
readonly BASE_URL="https://aistupidlevel.info"
readonly DASHBOARD_URL="${BASE_URL}/dashboard/cached?period=latest&sortBy=combined&analyticsPeriod=latest"
readonly GLOBAL_INDEX_URL="${BASE_URL}/dashboard/global-index"
readonly HISTORY_URL="${BASE_URL}/dashboard/history"
readonly MODEL_API_URL="${BASE_URL}/api/models"
readonly BOX_WIDTH=55
readonly MIN_TERM_WIDTH=$((BOX_WIDTH + 2))
NARROW_TERM=false
if [[ ! -t 1 ]] || [[ -n "${NO_COLOR:-}" ]]; then
  NARROW_TERM=true
elif TERM_WIDTH=$(tput cols 2>/dev/null); then
  if ((TERM_WIDTH < MIN_TERM_WIDTH)); then
    NARROW_TERM=true
  fi
fi
readonly NARROW_TERM

# ── Dependency Check ────────────────────────────────
if ! command -v jq &>/dev/null; then
  echo "Error: jq is required but not installed."
  echo "Install it via: brew install jq"
  exit 1
fi

if ! command -v curl &>/dev/null; then
  echo "Error: curl is required but not installed."
  exit 1
fi

# ── Colors ──────────────────────────────────────────
if [[ -n "${NO_COLOR:-}" ]]; then
  RST="" BOLD="" DIM="" RED="" GREEN="" YELLOW="" GOLD="" CYAN="" GRAY="" WHITE="" TRACK_HL=""
else
  RST=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  RED=$'\033[31m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  GOLD=$'\033[38;5;220m'
  CYAN=$'\033[36m'
  GRAY=$'\033[90m'
  WHITE=$'\033[97m'
  TRACK_HL=$'\033[1;97;45m'
fi
readonly RST BOLD DIM RED GREEN YELLOW GOLD CYAN GRAY WHITE TRACK_HL

# ── Symbols ─────────────────────────────────────────
readonly SYM_CHECK='✓'
readonly SYM_CROSS='✗'
readonly SYM_WARN='⚠'
readonly SYM_STAR='★'
readonly SYM_DIAMOND='◆'
readonly SYM_ARROW='→'
readonly SYM_BULLET='•'
readonly SYM_UP='↑'
readonly SYM_DOWN='↓'
readonly SYM_POINTER='▸'

# ── Box Drawing Helpers ─────────────────────────────
# Right border column (2 indent + BOX_WIDTH)
readonly RIGHT_COL=$((BOX_WIDTH + 2))

box_top() {
  local title="$1"
  local title_len=${#title}
  # ╭── (3) + space (1) + title + space (1) + dashes + ╮ (1) = BOX_WIDTH
  local dashes=$((BOX_WIDTH - title_len - 6))
  if ((dashes < 1)); then dashes=1; fi
  if [[ "$NARROW_TERM" == true ]]; then
    printf "  ${DIM}╭──${RST} ${BOLD}%s${RST} ${DIM}%s${RST}\n" "$title" "$(printf '%*s' "$dashes" '' | tr ' ' '─')"
  else
    printf "  ${DIM}╭──${RST} ${BOLD}%s${RST} ${DIM}%s╮${RST}\n" "$title" "$(printf '%*s' "$dashes" '' | tr ' ' '─')"
  fi
}

box_row() {
  local content="$1"
  if [[ "$NARROW_TERM" == true ]]; then
    printf "  ${DIM}│${RST} %s${RST}\n" "$content"
  else
    # Use cursor positioning to place right border at fixed column
    # This avoids all Unicode display-width issues
    printf "  ${DIM}│${RST} %s${RST}\033[${RIGHT_COL}G${DIM}│${RST}\n" "$content"
  fi
}

box_bottom() {
  # ╰ (1) + dashes + ╯ (1) = BOX_WIDTH
  if [[ "$NARROW_TERM" == true ]]; then
    printf "  ${DIM}╰%s${RST}\n" "$(printf '%*s' $((BOX_WIDTH - 2)) '' | tr ' ' '─')"
  else
    printf "  ${DIM}╰%s╯${RST}\n" "$(printf '%*s' $((BOX_WIDTH - 2)) '' | tr ' ' '─')"
  fi
}

box_empty() {
  box_row "${GRAY}${1}${RST}"
}

# ── Dot Leader Helper ───────────────────────────────
dot_row() {
  local label="$1" value="$2"
  local label_stripped
  label_stripped=$(printf '%s' "$label" | sed $'s/\033\\[[0-9;]*m//g')
  local value_stripped
  value_stripped=$(printf '%s' "$value" | sed $'s/\033\\[[0-9;]*m//g')
  local total_content=$((${#label_stripped} + ${#value_stripped}))
  # 1 (│) + 1 (space) + label + dots + value + 2 (padding) + 1 (│) = BOX_WIDTH
  local dots=$((BOX_WIDTH - total_content - 6))
  if ((dots < 2)); then dots=2; fi
  local dot_str
  dot_str=$(printf '%*s' "$dots" '' | tr ' ' '·')
  box_row "${label} ${DIM}${dot_str}${RST} ${value}"
}

# ── Status Color Helper ─────────────────────────────
status_color() {
  local status="$1"
  case "$status" in
  excellent) printf '%s' "${GOLD}" ;;
  stable | good) printf '%s' "${GREEN}" ;;
  volatile | warning | minor) printf '%s' "${YELLOW}" ;;
  degraded | critical | unreliable | major) printf '%s' "${RED}" ;;
  recovering) printf '%s' "${CYAN}" ;;
  *) printf '%s' "${RST}" ;;
  esac
}

status_label() {
  local status="$1"
  case "$status" in
  excellent) echo "EXCELLENT" ;;
  stable | good) echo "STABLE" ;;
  volatile | warning) echo "VOLATILE" ;;
  degraded | critical) echo "DEGRADED" ;;
  recovering) echo "RECOVERING" ;;
  *) echo "$status" | tr '[:lower:]' '[:upper:]' ;;
  esac
}

# ── Track Highlight Helper ─────────────────────────
TRACK_MODEL=""

highlight_model() {
  local name="$1"
  if [[ -n "$TRACK_MODEL" && "$name" == *"$TRACK_MODEL"* ]]; then
    printf '%s' "${TRACK_HL}${name}${RST}"
  else
    printf '%s' "$name"
  fi
}

# ── Spinner ─────────────────────────────────────────
SPINNER_PID=""

spinner_start() {
  local msg="${1:-Fetching data}"
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  (
    local i=0
    while true; do
      printf '\r%s' "  ${DIM}${frames[$i]} ${msg}${RST}" >&2
      i=$(((i + 1) % ${#frames[@]}))
      sleep 0.08
    done
  ) &
  SPINNER_PID=$!
}

spinner_stop() {
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
    if [[ "$NARROW_TERM" == true ]]; then
      printf '\r%s' "$(printf '%*s' 40 '')" >&2
      printf '\r' >&2
    else
      printf "\r\033[2K" >&2
    fi
  fi
}

trap spinner_stop EXIT

# ── Coding Score Calculation ───────────────────────
# Linear weighted sum of the seven hourly-suite axes, using the weights the
# site publishes for the code benchmark (correctness 35%, spec 15%,
# codeQuality 15%, efficiency 10%, stability 10%, refusal 10%, recovery 5%).
calc_coding_score() {
  local corr="$1" spec="$2" cq="$3" eff="$4" stab="$5" ref="$6" rec="$7"
  awk -v corr="$corr" -v spec="$spec" -v cq="$cq" -v eff="$eff" \
    -v stab="$stab" -v ref="$ref" -v rec="$rec" '
    BEGIN {
      printf "%.1f", corr*35 + spec*15 + cq*15 + eff*10 + stab*10 + ref*10 + rec*5
    }'
}

fetch_coding_scores() {
  local dashboard="$1"
  local tmpdir
  tmpdir=$(mktemp -d)

  # Get model IDs for the provider
  local model_ids
  model_ids=$(printf '%s\n' "$dashboard" | jq -r \
    --arg provider "$PROVIDER" \
    '[.data.modelScores[] | select(.provider == $provider) | .id] | .[]')

  # Fetch history for each model in parallel
  local pids=()
  for id in $model_ids; do
    curl -sf --max-time 10 "${HISTORY_URL}/${id}?period=latest&sortBy=hourly" \
      >"${tmpdir}/${id}.json" 2>/dev/null &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  # Calculate coding score for each model
  local results=()
  for id in $model_ids; do
    local file="${tmpdir}/${id}.json"
    [[ -s "$file" ]] || continue

    local name axes
    name=$(printf '%s\n' "$dashboard" | jq -r \
      --arg id "$id" '.data.modelScores[] | select(.id == $id) | .name')
    axes=$(jq -r '.data[0].axes // {} |
      [.correctness, .spec, .codeQuality, .efficiency, .stability, .refusal, .recovery] |
      if any(. == null) then empty else @tsv end' "$file" 2>/dev/null) || continue
    [[ -z "$axes" ]] && continue

    local corr spec cq eff stab ref rec
    read -r corr spec cq eff stab ref rec <<<"$axes"

    local score
    score=$(calc_coding_score "$corr" "$spec" "$cq" "$eff" "$stab" "$ref" "$rec")

    results+=("${score}|${name}|${corr}|${spec}|${cq}")
  done

  rm -rf "$tmpdir"

  # Sort by score descending
  printf '%s\n' "${results[@]}" | sort -t'|' -k1 -rn
}

# Emits one line per provider model, in dashboard order, tab-separated:
# name<TAB>id<TAB>currentScore<TAB>status<TAB>tier (tier may be empty).
fetch_tiers() {
  local dashboard="$1"
  local tmpdir
  tmpdir=$(mktemp -d)

  local rows
  rows=$(printf '%s\n' "$dashboard" | jq -r \
    --arg provider "$PROVIDER" \
    '.data.modelScores[] | select(.provider == $provider) | [.name, .id, (.currentScore|tostring), .status] | @tsv')

  # Fetch per-model tier data in parallel
  local pids=()
  local name id score status
  while IFS=$'\t' read -r name id score status; do
    [[ -z "$id" ]] && continue
    curl -sf --max-time 10 "${MODEL_API_URL}/${id}" \
      >"${tmpdir}/${id}.json" 2>/dev/null &
    pids+=($!)
  done <<<"$rows"
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  while IFS=$'\t' read -r name id score status; do
    [[ -z "$id" ]] && continue
    local file="${tmpdir}/${id}.json"
    local tier=""
    if [[ -s "$file" ]]; then
      tier=$(jq -r '(.latestScore.note // "") | [match("tier\\(([0-9]+)\\)"; "g").captures[0].string] | .[0] // empty' "$file" 2>/dev/null) || tier=""
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$id" "$score" "$status" "$tier"
  done <<<"$rows"

  rm -rf "$tmpdir"
}

# Pure decision rule — no network, no globals except its arguments.
# Prints: verdict<TAB>tracked_name<TAB>tracked_tier<TAB>top_tier<TAB>target_name<TAB>target_score<TAB>target_tier
compute_switch_suggestion() {
  local tier_rows="$1" track_model="$2"

  local tracked_name="" tracked_tier=""
  local top_tier=-1
  local name id score status tier

  # Resolve the tracked model: first row whose name contains track_model.
  while IFS=$'\t' read -r name id score status tier; do
    [[ -z "$name" ]] && continue
    if [[ -z "$tracked_name" && "$name" == *"$track_model"* ]]; then
      tracked_name="$name"
      tracked_tier="$tier"
    fi
  done <<<"$tier_rows"

  if [[ -z "$tracked_name" ]]; then
    printf 'NOT_FOUND\t\t\t\t\t\t\n'
    return
  fi

  # Candidate set = rows with a non-empty tier; find the top tier.
  local has_candidate=false
  while IFS=$'\t' read -r name id score status tier; do
    [[ -z "$name" ]] && continue
    [[ -z "$tier" ]] && continue
    has_candidate=true
    ((tier > top_tier)) && top_tier=$tier
  done <<<"$tier_rows"

  if [[ "$has_candidate" != true ]]; then
    printf 'UNAVAILABLE\t\t\t\t\t\t\n'
    return
  fi

  if [[ -z "$tracked_tier" ]]; then
    printf 'UNKNOWN\t%s\t\t\t\t\t\n' "$tracked_name"
    return
  fi

  if ((tracked_tier == top_tier)); then
    printf 'KEEP\t%s\t%s\t%s\t\t\t\n' "$tracked_name" "$tracked_tier" "$top_tier"
    return
  fi

  # SWITCH — pick the candidate with tier == top_tier and the highest score
  # (non-numeric score counts as -1); on a score tie the first in dashboard
  # order wins.
  local target_name="" target_score="" target_tier="" target_cmp=-1
  while IFS=$'\t' read -r name id score status tier; do
    [[ -z "$name" ]] && continue
    [[ "$tier" != "$top_tier" ]] && continue
    local cmp_score="$score"
    [[ "$cmp_score" =~ ^-?[0-9]+$ ]] || cmp_score=-1
    if [[ -z "$target_name" ]] || ((cmp_score > target_cmp)); then
      target_name="$name"
      target_score="$score"
      target_tier="$tier"
      target_cmp="$cmp_score"
    fi
  done <<<"$tier_rows"

  printf 'SWITCH\t%s\t%s\t%s\t%s\t%s\t%s\n' "$tracked_name" "$tracked_tier" "$top_tier" "$target_name" "$target_score" "$target_tier"
}

# ── Fetch Data ──────────────────────────────────────
readonly MAX_RETRIES="${AST_MAX_RETRIES:-10}"
# Longest wait between retries. Delays ramp linearly up to this value, so early
# retries fire fast and shrug off transient startup/connection failures.
readonly RETRY_INTERVAL="${AST_RETRY_INTERVAL:-30}"

# Linear ramp: attempt N waits ceil(RETRY_INTERVAL * N / MAX_RETRIES) seconds,
# so the final attempt waits exactly RETRY_INTERVAL. Never less than 1s.
retry_delay() {
  local attempt="$1"
  local delay
  delay=$(((RETRY_INTERVAL * attempt + MAX_RETRIES - 1) / MAX_RETRIES))
  if ((delay < 1)); then
    delay=1
  fi
  printf '%d' "$delay"
}

# Render whole seconds as a compact duration: 45s, 2m, 2m45s.
format_duration() {
  local total="$1"
  local mins=$((total / 60))
  local secs=$((total % 60))
  if ((mins == 0)); then
    printf '%ds' "$secs"
  elif ((secs == 0)); then
    printf '%dm' "$mins"
  else
    printf '%dm%ds' "$mins" "$secs"
  fi
}

fetch_data() {
  local url="$1"
  local response
  local attempt=0
  local waited=0

  while true; do
    if response=$(curl -sf --max-time 10 "$url" 2>/dev/null) && [[ -n "$response" ]]; then
      # Clear retry line if we had been retrying
      if ((attempt > 0)); then
        printf '\r\033[2K' >&2
      fi
      printf '%s\n' "$response"
      return 0
    fi

    # First failure — stop spinner if running
    if ((attempt == 0)); then
      spinner_stop
    fi

    attempt=$((attempt + 1))

    if ((attempt > MAX_RETRIES)); then
      printf '\r\033[2K' >&2
      printf '%s\n' "  ${RED}${SYM_CROSS} API unreachable after ${MAX_RETRIES} retries ($(format_duration "$waited")). Giving up.${RST}" >&2
      return 1
    fi

    local delay
    delay=$(retry_delay "$attempt")
    waited=$((waited + delay))

    local countdown
    for ((countdown = delay; countdown > 0; countdown--)); do
      printf '\r\033[2K  %s' "${YELLOW}${SYM_WARN} API unreachable — retry ${attempt}/${MAX_RETRIES} (${countdown}s)${RST}" >&2
      sleep 1
    done
  done
}

# ── JSON Output ─────────────────────────────────────
output_json() {
  local dashboard global_index
  dashboard=$(fetch_data "$DASHBOARD_URL")
  global_index=$(fetch_data "$GLOBAL_INDEX_URL")

  local now
  now=$(date +"%Y-%m-%d %H:%M")

  local reco
  reco=$(echo "$dashboard" | jq '.data.recommendations')

  # Calculate best coder
  local coding_scores
  coding_scores=$(fetch_coding_scores "$dashboard")
  local best_coder_json='null'
  if [[ -n "$coding_scores" ]]; then
    local top_line
    top_line=$(head -1 <<<"$coding_scores")
    local cscore cname corr spec cq
    IFS='|' read -r cscore cname corr spec cq <<<"$top_line"
    best_coder_json=$(jq -n \
      --arg name "$cname" \
      --argjson score "$cscore" \
      --argjson correctness "$(awk -v v="$corr" 'BEGIN { printf "%.0f", v * 100 }')" \
      --argjson spec "$(awk -v v="$spec" 'BEGIN { printf "%.0f", v * 100 }')" \
      --argjson codeQuality "$(awk -v v="$cq" 'BEGIN { printf "%.0f", v * 100 }')" \
      '{name: $name, score: $score, correctness: $correctness, spec: $spec, codeQuality: $codeQuality}')
  fi

  # Build the entire JSON in a single jq call
  jq -n \
    --arg version "$VERSION" \
    --arg timestamp "$now" \
    --arg provider "$PROVIDER" \
    --arg model_pattern "$MODEL_NAME_PATTERN" \
    --argjson global_index "$global_index" \
    --argjson dashboard "$dashboard" \
    --argjson reco "$reco" \
    --argjson best_coder "$best_coder_json" \
    '
    {
      version: $version,
      timestamp: $timestamp,
      provider: $provider,
      globalIndex: {
        score: $global_index.data.current.globalScore,
        trend: $global_index.data.trend,
        performingWell: $global_index.data.performingWell,
        totalModels: $global_index.data.totalModels
      },

      rankings: [
        $dashboard.data.modelScores | to_entries[] |
        select(.value.provider == $provider) |
        {
          rank: (.key + 1),
          name: .value.name,
          score: .value.currentScore,
          status: (
            if .value.status == "good" then "stable"
            elif .value.status == "warning" then "volatile"
            else .value.status
            end
          )
        }
      ],

      bestCoder: $best_coder,

      bestFor: {
        code: (if $reco.bestForCode.vendor == $provider
          then {name: $reco.bestForCode.name, score: $reco.bestForCode.score}
          else null end),
        reliable: (if $reco.mostReliable.vendor == $provider
          then {name: $reco.mostReliable.name, score: $reco.mostReliable.score}
          else null end),
        fastest: (if $reco.fastestResponse.vendor == $provider
          then {name: $reco.fastestResponse.name, score: $reco.fastestResponse.score}
          else null end),
        value: (if ($reco.bestValue // {}).vendor == $provider
          then {name: $reco.bestValue.name, score: $reco.bestValue.score}
          else null end)
      },

      alerts: {
        avoid: [
          ($reco.avoidNow // [])[] |
          select(.vendor == $provider or .provider == $provider) |
          .name
        ],
        degradations: [
          $dashboard.data.degradations[] |
          select(.provider == $provider) |
          {
            model: .modelName,
            severity: .severity,
            type: .type,
            message: .message
          }
        ]
      },

      providerTrust: (
        [$dashboard.data.providerReliability[] | select(.provider == $provider)] |
        if length > 0 then
          .[0] | {
            score: .trustScore,
            trend: .trend,
            incidentsPerMonth: .incidentsPerMonth
          }
        else null end
      ),

      driftIncidents: [
        ($dashboard.data.driftIncidents // []) |
        [.[] | select(.provider == $provider or (.modelName | test($model_pattern; "i")))] |
        group_by(.modelName)[] |
        {
          model: .[0].modelName,
          severity: .[0].severity,
          count: length
        }
      ]
    }
    '
}

# ── Section Renderers ──────────────────────────────
# Each render_* function uses variables set by render()

render_global() {
  local trend_color
  trend_color=$(status_color "$R_G_TREND")

  box_top "Global AI Index"
  dot_row "Score" "${BOLD}${trend_color}${R_G_SCORE}${RST}/100 ${trend_color}$(status_label "$R_G_TREND")${RST}"
  dot_row "Performing well" "${BOLD}${R_G_PERFORMING}${RST}/${R_G_TOTAL}"
  if [[ -n "$R_GOOD_MODELS" ]]; then
    local display="$R_GOOD_MODELS"
    local max_len=44
    if ((${#display} > max_len)); then
      display="${display:0:$((max_len - 3))}..."
    fi
    box_row "  ${GREEN}${SYM_ARROW}${RST} ${DIM}${display}${RST}"
  fi
  box_bottom
  printf "\n"
}

render_rankings() {
  box_top "${PROVIDER_LABEL} Rankings"
  if ((R_MODEL_COUNT == 0)); then
    box_empty "No ${PROVIDER_LABEL} models found in rankings"
  else
    printf '%s\n' "$R_DATA" | jq -r '.models[] | "\(.rank)|\(.name)|\(.score)|\(.status)"' | while IFS='|' read -r rank name score status; do
      local rank_str
      rank_str=$(printf '#%-2s' "$rank")
      local name_display
      name_display=$(highlight_model "$name")

      if [[ "$status" == "unavailable" ]]; then
        local pad_len=$((R_MAX_NAME_LEN - ${#name}))
        local pad_str
        pad_str=$(printf '%*s' "$pad_len" '')
        box_row "${BOLD}${WHITE}${rank_str}${RST}     ${name_display}${pad_str} ${GRAY}${SYM_CROSS}   ${SYM_CROSS} UNAVAILABLE${RST}"
        continue
      fi

      local sc
      sc=$(status_color "$status")
      local sl
      sl=$(status_label "$status")
      local change_col="    "
      if [[ -n "$R_PREV_RANKS" ]]; then
        local prev_rank
        prev_rank=$(printf '%s\n' "$R_PREV_RANKS" | jq -r --arg n "$name" '.[$n] // empty')
        if [[ -n "$prev_rank" ]] && ((prev_rank != rank)); then
          local arrow_text
          if ((rank < prev_rank)); then
            arrow_text="${GREEN}${SYM_UP}${prev_rank}${RST}"
          else
            arrow_text="${RED}${SYM_DOWN}${prev_rank}${RST}"
          fi
          local visible_len=$((1 + ${#prev_rank}))
          local pad=$((4 - visible_len))
          change_col="${arrow_text}$(printf '%*s' "$pad" '')"
        fi
      fi
      local score_str
      score_str=$(printf '%-3s' "$score")
      local sym
      case "$status" in
      excellent) sym="$SYM_STAR" ;;
      good | stable) sym="$SYM_CHECK" ;;
      volatile | warning) sym="$SYM_WARN" ;;
      *) sym="$SYM_CROSS" ;;
      esac
      local pad_len=$((R_MAX_NAME_LEN - ${#name}))
      local pad_str
      pad_str=$(printf '%*s' "$pad_len" '')
      box_row "${BOLD}${WHITE}${rank_str}${RST} ${change_col}${name_display}${pad_str} ${BOLD}${score_str}${RST} ${sc}${sym} ${sl}${RST}"
    done
  fi
  box_bottom
  printf "\n"
}

render_recommendations() {
  box_top "Recommendations (7d)"
  if ((R_BEST_COUNT == 0)); then
    box_empty "No ${PROVIDER_LABEL} model in recommendations"
  else
    printf '%s\n' "$R_DATA" | jq -r '.bestFor[] | "\(.label)|\(.pad)|\(.name)|\(.score)"' | while IFS='|' read -r label pad_len name score; do
      local pad
      pad=$(printf '%*s' "$pad_len" '')
      local name_display
      name_display=$(highlight_model "$name")
      box_row "${GREEN}${SYM_CHECK} ${label}${RST}${pad}${name_display} (${BOLD}${score}${RST})"
    done
  fi
  box_bottom
  printf "\n"
}

render_coder() {
  box_top "Best Coder (${PROVIDER_LABEL})"
  local coding_scores
  coding_scores=$(fetch_coding_scores "$R_DASHBOARD")
  if [[ -z "$coding_scores" ]]; then
    box_empty "Could not calculate coding scores"
  else
    local top_line
    top_line=$(head -1 <<<"$coding_scores")
    local cscore name corr spec cq
    IFS='|' read -r cscore name corr spec cq <<<"$top_line"
    local corr_pct spec_pct cq_pct
    corr_pct=$(awk -v v="$corr" 'BEGIN { printf "%d", v * 100 }')
    spec_pct=$(awk -v v="$spec" 'BEGIN { printf "%d", v * 100 }')
    cq_pct=$(awk -v v="$cq" 'BEGIN { printf "%d", v * 100 }')
    local name_display
    name_display=$(highlight_model "$name")
    box_row "${GREEN}${SYM_CHECK}${RST} ${name_display} ${BOLD}${cscore}${RST}"
    box_row "  ${DIM}Correctness ${corr_pct}%  Spec ${spec_pct}%  Quality ${cq_pct}%${RST}"
  fi
  box_bottom
  printf "\n"
}

render_alerts() {
