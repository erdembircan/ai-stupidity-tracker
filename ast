# ── Graph Rendering ───────────────────────────────
# Braille-based sparkline chart for model score over time
# GRAPH_DATA is a space-separated list of "timestamp@score" pairs
GRAPH_DATA=""
GRAPH_MODEL=""
SWITCHER_ACTIVE=false
PICKER_RESULT=""
PICKER_NAMES=()
PICKER_SCORES=()
PICKER_STATUSES=()
PICKER_MAXLEN=0

render_graph() {
  [[ -z "$GRAPH_MODEL" ]] && return

  box_top "Score Graph: ${GRAPH_MODEL}"

  if [[ -z "$GRAPH_DATA" ]]; then
    box_empty "Collecting data... graph appears after 2 ticks"
    box_bottom
    printf "\n"
    return
  fi

  local scores=()
  local times=()
  local IFS=' '
  for entry in $GRAPH_DATA; do
    times+=("${entry%%@*}")
    scores+=("${entry#*@}")
  done

  local count=${#scores[@]}

  # Find min/max for scaling
  local min=100 max=0
  for s in "${scores[@]}"; do
    ((s < min)) && min=$s
    ((s > max)) && max=$s
  done

  # Add padding to range
  local range_pad=5
  min=$((min - range_pad))
  max=$((max + range_pad))
  ((min < 0)) && min=0
  ((max > 100)) && max=100
  local range=$((max - min))
  ((range < 1)) && range=1

  # Chart dimensions (inside box)
  local chart_height=8
  local chart_width=$((BOX_WIDTH - 10))

  # Build chart rows (top to bottom)
  local row
  for ((row = chart_height - 1; row >= 0; row--)); do
    local threshold_low=$((min + (range * row / chart_height)))
    local threshold_high=$((min + (range * (row + 1) / chart_height)))
    local label
    if ((row == chart_height - 1)); then
      label=$(printf '%3d' "$max")
    elif ((row == 0)); then
      label=$(printf '%3d' "$min")
    else
      label="   "
    fi
    local line=""
    local col
    for ((col = 0; col < chart_width; col++)); do
      # Map column to data index (equal-width segments)
      local idx=$((col * count / chart_width))
      local val=${scores[$idx]}
      if ((val >= threshold_high)); then
        line+="█"
      elif ((val >= threshold_low)); then
        line+="▄"
      else
        line+=" "
      fi
    done
    box_row "${DIM}${label}${RST} ${CYAN}${line}${RST}"
  done

  # Time axis
  local first_time="${times[0]}"
  local last_time="${times[$((count - 1))]}"
  local axis_pad=$((chart_width - ${#first_time} - ${#last_time}))
  ((axis_pad < 1)) && axis_pad=1
  box_row "    ${DIM}${first_time}$(printf '%*s' "$axis_pad" '')${last_time}${RST}"

  # Current value
  local latest=${scores[$((count - 1))]}
  local delta_str=""
  if ((count >= 2)); then
    local prev=${scores[$((count - 2))]}
    local delta=$((latest - prev))
    if ((delta > 0)); then
      delta_str="${GREEN}${SYM_UP}+${delta}${RST}"
    elif ((delta < 0)); then
      delta_str="${RED}${SYM_DOWN}${delta}${RST}"
    else
      delta_str="${DIM}unchanged${RST}"
    fi
  fi
  local current_val="${BOLD}${latest}${RST}"
  if [[ -n "$delta_str" ]]; then
    current_val="${current_val} ${delta_str}"
  fi
  dot_row "Current" "$current_val"
  dot_row "Samples" "${count}"

  box_bottom
  printf "\n"
}

# ── Provider Model List ────────────────────────────
# Emits the current provider's switchable models as name\tscore\tstatus,
# one per line, in alphabetical order by name. Models with status
# "unavailable" are excluded — you cannot meaningfully graph a model
# with no score.
provider_model_rows() {
  local dashboard="$1"
  printf '%s\n' "$dashboard" | jq -r --arg provider "$PROVIDER" '
    [.data.modelScores[] | select(.provider == $provider and .status != "unavailable")]
    | sort_by(.name)
    | .[] | [.name, (.currentScore | tostring), .status] | @tsv'
}

# ── Apply Model Selection ──────────────────────────
# Repoint the active track/graph target to the newly chosen model.
# Only features that were already active are updated; the graph history
# is reset only when the graphed model actually changes.
apply_model_selection() {
  local selected="$1"
  [[ -z "$selected" ]] && return
  if [[ -n "$GRAPH_MODEL" && "$selected" != "$GRAPH_MODEL" ]]; then
    GRAPH_MODEL="$selected"
    GRAPH_DATA=""
  fi
  if [[ -n "$TRACK_MODEL" ]]; then
    TRACK_MODEL="$selected"
  fi
}

# ── Model Picker View ──────────────────────────────
# Full-screen picker. Reads the PICKER_NAMES / PICKER_SCORES /
# PICKER_STATUSES / PICKER_MAXLEN globals populated by picker_loop.
# Arg: selected index.
render_picker() {
  local sel="$1"
  local maxlen="$PICKER_MAXLEN"
  local target="${GRAPH_MODEL:-$TRACK_MODEL}"

  local now
  now=$(date +"%Y-%m-%d %H:%M")

  printf "\n"
  printf '%s\n' "  ${BOLD}${CYAN}${SYM_DIAMOND} AST${RST}  ${DIM}v${VERSION} ${GRAY}${SYM_BULLET} ${now}${RST}"
  printf "\n"

  box_top "Switch Model · ${PROVIDER_LABEL}"
  if ((${#PICKER_NAMES[@]} == 0)); then
    box_empty "No switchable ${PROVIDER_LABEL} models available"
  else
    local i
    for ((i = 0; i < ${#PICKER_NAMES[@]}; i++)); do
      local name="${PICKER_NAMES[$i]}"
      local score="${PICKER_SCORES[$i]}"
      local status="${PICKER_STATUSES[$i]}"
      local sym sc
      case "$status" in
      excellent)
        sym="$SYM_STAR"
        sc="$GOLD"
        ;;
      good | stable)
        sym="$SYM_CHECK"
        sc="$GREEN"
        ;;
      volatile | warning)
        sym="$SYM_WARN"
        sc="$YELLOW"
        ;;
      *)
        sym="$SYM_CROSS"
        sc="$RED"
        ;;
      esac
      local pad_len=$((maxlen - ${#name}))
      ((pad_len < 0)) && pad_len=0
      local pad_str
      pad_str=$(printf '%*s' "$pad_len" '')
      local cur_tag=""
      [[ "$name" == "$target" ]] && cur_tag=" ${DIM}(current)${RST}"
      local score_str
      score_str=$(printf '%-3s' "$score")
      if ((i == sel)); then
        box_row "${CYAN}${BOLD}${SYM_POINTER}${RST} ${BOLD}${WHITE}${name}${RST}${pad_str} ${BOLD}${score_str}${RST} ${sc}${sym}${RST}${cur_tag}"
      else
        box_row "  ${name}${pad_str} ${score_str} ${sc}${sym}${RST}${cur_tag}"
      fi
    done
  fi
  box_bottom
  printf "\n"
  printf '%s\n' "  ${DIM}${SYM_UP}/${SYM_DOWN} move ${GRAY}${SYM_BULLET}${RST} ${DIM}Enter select ${GRAY}${SYM_BULLET}${RST} ${DIM}q/Esc cancel${RST}"
}

# ── Model Picker Loop ──────────────────────────────
picker_loop() {
  local dashboard="$1"
  PICKER_RESULT=""
  PICKER_NAMES=()
  PICKER_SCORES=()
  PICKER_STATUSES=()
  PICKER_MAXLEN=0

  local rows
  rows=$(provider_model_rows "$dashboard")

  if [[ -n "$rows" ]]; then
    local name score status
    while IFS=$'\t' read -r name score status; do
      [[ -z "$name" ]] && continue
      PICKER_NAMES+=("$name")
      PICKER_SCORES+=("$score")
      PICKER_STATUSES+=("$status")
      ((${#name} > PICKER_MAXLEN)) && PICKER_MAXLEN=${#name}
    done <<<"$rows"
  fi

  local count=${#PICKER_NAMES[@]}
  local target="${GRAPH_MODEL:-$TRACK_MODEL}"

  # Start cursor on the current target if present.
  local sel=0 i
  for ((i = 0; i < count; i++)); do
    if [[ "${PICKER_NAMES[$i]}" == "$target" ]]; then
      sel=$i
      break
    fi
  done

  while true; do
    local frame
    frame=$(render_picker "$sel")
    # Clear each line to EOL before drawing it, so a shorter picker row never
    # leaves the previous frame's tail behind — mid-line (box_row jumps the
    # cursor to the border column without erasing) or right of the border.
    # \033[J then clears any lines below the frame.
    printf '\033[H\033[K%s\033[J' "${frame//$'\n'/$'\n\033[K'}"

    local key=""
    IFS= read -rsn1 key 2>/dev/null || true

    # Empty read == Enter (newline stripped by read -n1).
    if [[ -z "$key" ]]; then
      if ((count > 0)); then
        PICKER_RESULT="${PICKER_NAMES[$sel]}"
      fi
      return
    fi

    case "$key" in
    $'\033')
      # Possible arrow-key escape sequence; bare Esc == cancel.
      # Integer -t 1 keeps this bash-3.2-safe: buffered "[A"/"[B" bytes
      # return instantly; a bare Esc falls through after <=1s.
      local rest=""
      IFS= read -rsn2 -t 1 rest 2>/dev/null || true
      case "$rest" in
      '[A') ((count > 0)) && sel=$(((sel - 1 + count) % count)) ;;
      '[B') ((count > 0)) && sel=$(((sel + 1) % count)) ;;
      *)
        PICKER_RESULT=""
        return
        ;;
      esac
      ;;
    k | K) ((count > 0)) && sel=$(((sel - 1 + count) % count)) ;;
    j | J) ((count > 0)) && sel=$(((sel + 1) % count)) ;;
    q | Q)
      PICKER_RESULT=""
      return
      ;;
    esac
  done
}

readonly DEFAULT_SECTION_ORDER="global,rankings,recommendations,coder,alerts,trust,drift"

# ── Render ─────────────────────────────────────────
render() {
  R_DASHBOARD="$1"
  local global_index="$2" last_updated="$3"
  R_PREV_RANKS="${4:-}"

  # ── Extract all global index data in one call ───
  # current.globalScore is occasionally null while a new period is being computed;
  # fall back to the most recent non-null history entry so the row stays populated.
  IFS=$'\t' read -r R_G_SCORE R_G_TREND R_G_PERFORMING R_G_TOTAL < <(
    printf '%s\n' "$global_index" | jq -r '[
      (.data.current.globalScore // ([.data.history[]? | select(.globalScore != null)][0].globalScore // "—")),
      .data.trend,
      .data.performingWell,
      .data.totalModels
    ] | @tsv'
  )

  # ── Extract all dashboard data in one call ──────
  R_DATA=$(printf '%s\n' "$R_DASHBOARD" | jq --arg provider "$PROVIDER" --arg model_pattern "$MODEL_NAME_PATTERN" '
    (.data.modelScores | to_entries | [.[] | select(.value.provider == $provider)]) as $models |
    (.data.recommendations) as $reco |
    {
      goodModels: ([.data.modelScores[] | select(.status == "good" or .status == "excellent") | .name] | join(", ")),
      models: [$models[] | {rank: (.key + 1), name: .value.name, score: .value.currentScore, status: .value.status}],
      modelCount: ($models | length),
      maxNameLen: ([$models[].value.name | length] | max // 0),
      bestFor: [
        (if $reco.bestForCode.vendor == $provider
         then {label: "BEST FOR CODE", pad: 5, name: $reco.bestForCode.name, score: $reco.bestForCode.score} else empty end),
        (if $reco.mostReliable.vendor == $provider
         then {label: "MOST RELIABLE", pad: 5, name: $reco.mostReliable.name, score: $reco.mostReliable.score} else empty end),
        (if $reco.fastestResponse.vendor == $provider
         then {label: "FASTEST RESPONSE", pad: 2, name: $reco.fastestResponse.name, score: $reco.fastestResponse.score} else empty end),
        (if ($reco.bestValue // {}).vendor == $provider
         then {label: "BEST VALUE", pad: 8, name: $reco.bestValue.name, score: $reco.bestValue.score} else empty end)
      ],
      avoidNow: [($reco.avoidNow // [])[] | select(.vendor == $provider or .provider == $provider) | .name],
      degradations: [.data.degradations[] | select(.provider == $provider) | {name: .modelName, severity, type, message}],
      providerTrust: (
        [.data.providerReliability[] | select(.provider == $provider)] |
        if length > 0 then .[0] | {score: .trustScore, trend, incidents: .incidentsPerMonth}
        else null end
      ),
      driftIncidents: [
        (.data.driftIncidents // []) |
        [.[] | select(.provider == $provider or (.modelName | test($model_pattern; "i")))] |
        group_by(.modelName)[] |
        {name: .[0].modelName, severity: (.[0].severity // "unknown"), count: length}
      ]
    }
  ')

  # ── Read all scalar fields from extracted data ──
  read -r R_MODEL_COUNT R_MAX_NAME_LEN R_BEST_COUNT R_AVOID_COUNT R_DEG_COUNT R_DRIFT_COUNT < <(
    printf '%s\n' "$R_DATA" | jq -r '[.modelCount, .maxNameLen, (.bestFor | length), (.avoidNow | length), (.degradations | length), (.driftIncidents | length)] | @tsv'
  )
  R_GOOD_MODELS=$(printf '%s\n' "$R_DATA" | jq -r '.goodModels')

  # ── Header ──────────────────────────────────────
  printf "\n"
  printf '%s\n' "  ${BOLD}${CYAN}${SYM_DIAMOND} AST${RST}  ${DIM}v${VERSION} ${GRAY}${SYM_BULLET} ${last_updated}${RST}"
  printf "\n"

  render_switch

  # ── Render sections in order ────────────────────
  local order="${SECTIONS:-$DEFAULT_SECTION_ORDER}"
  local section
  for section in ${order//,/ }; do
    "render_${section}"
  done
}

# ── Section Filter ─────────────────────────────────
SECTIONS=""
readonly VALID_SECTIONS="global,rankings,recommendations,coder,alerts,trust,drift,graph"

# ── Main ────────────────────────────────────────────
main() {
  local json_mode=false
  local watch_mode=false
  local watch_interval=1800
  local provider_mode=claude
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --version)
      printf '%s\n' "${VERSION}"
      exit 0
      ;;
    --help)
      printf '%s\n' "  ${BOLD}${CYAN}${SYM_DIAMOND} AST${RST}  ${DIM}v${VERSION}${RST} — AI Stupidity Tracker"
      printf '\n'
      printf '%s\n' "  ${BOLD}Usage:${RST}  ast [--claude|--openai] [options]"
      printf '\n'
      printf '%s\n' "  ${BOLD}Provider:${RST}"
      printf '%s\n' "    --claude            Track Claude/Anthropic models (default)"
      printf '%s\n' "    --openai            Track OpenAI models"
      printf '\n'
      printf '%s\n' "  ${BOLD}Options:${RST}"
      printf '%s\n' "    --json              Machine-readable JSON output"
      printf '%s\n' "    --watch[=SECONDS]   Live dashboard, refreshes every N seconds (default: 1800; Ctrl+R to refresh)"
      printf '%s\n' "    --graph=MODEL       Real-time score graph for a model (implies --watch)"
      printf '%s\n' "    --track=MODEL       Highlight a model and show the Switch Suggestion box"
      printf '%s\n' "    --section=LIST      Show only specific sections (comma-separated)"
      printf '%s\n' "                        Sections: global,rankings,recommendations,coder,alerts,trust,drift,graph"
      printf '%s\n' "    --version           Show version number"
      printf '%s\n' "    --help              Show this help message"
      printf '\n'
      printf '%s\n' "  ${BOLD}Model switcher:${RST}"
      printf '%s\n' "    In watch mode with --track or --graph, press ${BOLD}m${RST} to open a"
      printf '%s\n' "    picker and switch the tracked/graphed model without restarting."
      printf '\n'
      printf '%s\n' "  ${BOLD}Switch suggestion:${RST}"
      printf '%s\n' "    With --track, a box at the top says KEEP when the tracked model is in"
      printf '%s\n' "    the provider's top tier, or SWITCH and names the top-tier model to use."
      printf '\n'
      printf '%s\n' "  ${BOLD}Environment:${RST}"
      printf '%s\n' "    NO_COLOR=1          Disable colors and box-drawing right borders"
      exit 0
      ;;
    --json) json_mode=true ;;
    --claude) provider_mode=claude ;;
    --openai) provider_mode=openai ;;
    --section=*)
      SECTIONS="${1#--section=}"
      local s
      for s in ${SECTIONS//,/ }; do
        if [[ ",$VALID_SECTIONS," != *",$s,"* ]]; then
          printf "  ${RED}${SYM_CROSS} Unknown section: %s${RST}\n" "$s"
          printf "  Valid sections: %s\n" "$VALID_SECTIONS"
          exit 1
        fi
      done
      ;;
    --section)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        printf '%s\n' "  ${RED}${SYM_CROSS} --section requires a value${RST}"
        printf '  Valid sections: %s\n' "$VALID_SECTIONS"
        exit 1
      fi
      SECTIONS="$2"
      local s
      for s in ${SECTIONS//,/ }; do
        if [[ ",$VALID_SECTIONS," != *",$s,"* ]]; then
          printf "  ${RED}${SYM_CROSS} Unknown section: %s${RST}\n" "$s"
          printf "  Valid sections: %s\n" "$VALID_SECTIONS"
          exit 1
        fi
      done
      shift
      ;;
    --track=*)
      TRACK_MODEL="${1#--track=}"
      if [[ -z "$TRACK_MODEL" ]]; then
        printf '%s\n' "  ${RED}${SYM_CROSS} --track requires a model name${RST}"
        exit 1
      fi
      ;;
    --track)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        printf '%s\n' "  ${RED}${SYM_CROSS} --track requires a model name${RST}"
        exit 1
      fi
      TRACK_MODEL="$2"
      shift
      ;;
    --graph=*)
      GRAPH_MODEL="${1#--graph=}"
      if [[ -z "$GRAPH_MODEL" ]]; then
        printf '%s\n' "  ${RED}${SYM_CROSS} --graph requires a model name${RST}"
        exit 1
      fi
      ;;
    --graph)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        printf '%s\n' "  ${RED}${SYM_CROSS} --graph requires a model name${RST}"
        exit 1
      fi
      GRAPH_MODEL="$2"
      shift
      ;;
    --watch=*)
      watch_mode=true
      watch_interval="${1#--watch=}"
      if ! [[ "$watch_interval" =~ ^[0-9]+$ ]]; then
        printf "  ${RED}${SYM_CROSS} Invalid watch interval: %s (must be a number)${RST}\n" "$watch_interval"
        exit 1
      fi
      ;;
    --watch)
      watch_mode=true
      if [[ -n "${2:-}" && "$2" =~ ^[0-9]+$ ]]; then
        watch_interval="$2"
        shift
      fi
      ;;
    -*)
      printf "  ${RED}${SYM_CROSS} Unknown option: %s${RST}\n" "$1"
      printf "  Usage: ast [--claude|--openai] [--section=LIST] [--json] [--watch[=SECONDS]] [--help]\n"
      exit 1
      ;;
    *)
      printf "  ${RED}${SYM_CROSS} Unexpected argument: %s${RST}\n" "$1"
      printf "  Usage: ast [--claude|--openai] [--section=LIST] [--json] [--watch[=SECONDS]] [--help]\n"
      exit 1
      ;;
    esac
    shift
  done

  # Provider configuration
  case "$provider_mode" in
  claude)
    PROVIDER="anthropic"
    PROVIDER_LABEL="Claude"
    MODEL_NAME_PATTERN="claude"
    ;;
  openai)
    PROVIDER="openai"
    PROVIDER_LABEL="OpenAI"
    MODEL_NAME_PATTERN="gpt"
    ;;
  esac

  # --graph implies --watch and appends graph section to the bottom
  if [[ -n "$GRAPH_MODEL" ]]; then
    watch_mode=true
    if [[ -z "$SECTIONS" ]]; then
      SECTIONS="${DEFAULT_SECTION_ORDER},graph"
    elif [[ ",$SECTIONS," != *",graph,"* ]]; then
      SECTIONS="${SECTIONS},graph"
    fi
  fi

  # A track/graph target in watch mode enables the live model switcher.
  if [[ "$watch_mode" == true && (-n "$GRAPH_MODEL" || -n "$TRACK_MODEL") ]]; then
    SWITCHER_ACTIVE=true
  fi

  if [[ "$json_mode" == true ]]; then
    output_json
    return
  fi

  if [[ "$watch_mode" == true ]]; then
    watch_loop "$watch_interval"
    return
  fi

  # One-shot mode
  spinner_start "Fetching ${PROVIDER_LABEL} status"
  local dashboard global_index
  dashboard=$(fetch_data "$DASHBOARD_URL")
  global_index=$(fetch_data "$GLOBAL_INDEX_URL")

  local now
  now=$(date +"%Y-%m-%d %H:%M")

  local output
  output=$(render "$dashboard" "$global_index" "$now")
  spinner_stop
  printf '%s\n' "$output"
}

# ── Watch Loop ─────────────────────────────────────
watch_loop() {
  local WATCH_INTERVAL="${1:-60}"
  local first_run=true
  local prev_ranks="{}"

  trap 'exit 0' INT TERM

  while true; do
    # Flush any buffered stdin so stacked Ctrl+R presses during fetch are discarded
    while IFS= read -rsn1 -t 0 _ 2>/dev/null; do :; done

    if [[ "$first_run" == true ]]; then
      # First run: show spinner since there's nothing on screen yet
      spinner_start "Fetching ${PROVIDER_LABEL} status"
    fi

    local dashboard global_index
    dashboard=$(fetch_data "$DASHBOARD_URL")
    global_index=$(fetch_data "$GLOBAL_INDEX_URL")

    spinner_stop
    if [[ "$first_run" == true ]]; then
      first_run=false
    fi

    local now
    now=$(date +"%Y-%m-%d %H:%M")

    # Extract current rankings as {name: rank} map
    local curr_ranks
    curr_ranks=$(echo "$dashboard" | jq --arg provider "$PROVIDER" '
      [.data.modelScores | to_entries[] |
       select(.value.provider == $provider)] |
      map({(.value.name): (.key + 1)}) | add // {}
    ')

    # Collect graph data point if --graph is active
    if [[ -n "$GRAPH_MODEL" ]]; then
      local graph_score
      graph_score=$(printf '%s\n' "$dashboard" | jq -r \
        --arg name "$GRAPH_MODEL" \
        '[.data.modelScores[] | select(.name == $name)] | if length > 0 then .[0].currentScore else empty end')
      if [[ -n "$graph_score" ]]; then
        local tick_time
        tick_time=$(date +"%H:%M")
        if [[ -z "$GRAPH_DATA" ]]; then
          GRAPH_DATA="${tick_time}@${graph_score}"
        else
          GRAPH_DATA="${GRAPH_DATA} ${tick_time}@${graph_score}"
          # Cap to max visible samples (chart_width = BOX_WIDTH - 10)
          local max_samples=$((BOX_WIDTH - 10))
          local -a _gd
          read -ra _gd <<<"$GRAPH_DATA"
          if ((${#_gd[@]} > max_samples)); then
            GRAPH_DATA="${_gd[*]:(-${max_samples})}"
          fi
        fi
      elif [[ "$first_run" != true ]]; then
        # Model name not found — warn once
        if [[ -z "$GRAPH_DATA" ]]; then
          printf "  ${RED}${SYM_CROSS} Model '%s' not found in %s rankings${RST}\n" "$GRAPH_MODEL" "$PROVIDER_LABEL" >&2
          printf '%s\n' "  ${DIM}Available models:${RST}" >&2
          printf '%s\n' "$dashboard" | jq -r --arg provider "$PROVIDER" \
            '.data.modelScores[] | select(.provider == $provider) | "    " + .name' >&2
          exit 1
        fi
      fi
    fi

    # Capture output, then clear and print in one shot to reduce flicker
    local output
    output=$(render "$dashboard" "$global_index" "$now" "$prev_ranks")
    printf '\033[2J\033[H%s\n' "$output"

    local next_update
    next_update=$(date -d "+${WATCH_INTERVAL} seconds" +"%Y-%m-%d %H:%M" 2>/dev/null || date -v+"${WATCH_INTERVAL}S" +"%Y-%m-%d %H:%M")
    local switch_hint=""
    [[ "$SWITCHER_ACTIVE" == true ]] && switch_hint=" ${GRAY}${SYM_BULLET}${RST} ${DIM}m switch model${RST}"
    printf '%s\n' "  ${DIM}Next update ${next_update} ${GRAY}${SYM_BULLET}${RST} ${DIM}Ctrl+R refresh ${GRAY}${SYM_BULLET}${RST} ${DIM}Ctrl+C to exit${RST}${switch_hint}"

    prev_ranks="$curr_ranks"

    local key=""
    IFS= read -rsn1 -t "$WATCH_INTERVAL" key 2>/dev/null || true
    if [[ "$SWITCHER_ACTIVE" == true && ("$key" == "m" || "$key" == "M") ]]; then
      picker_loop "$dashboard"
      apply_model_selection "$PICKER_RESULT"
      continue
    fi
    if [[ "$key" == $'\x12' ]]; then
      spinner_start "Refreshing"
      continue
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
